{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varialgate.github.io/specs/spritevpg/schema/spritevpg-1.schema.json",
  "title": "SpriteVPG 1 · ficha de un sprite pattern",
  "description": "Ficha de una hoja de sprites SpriteVPG (Sprite Varial Pixel Gen). Especificación: https://varialgate.github.io/specs/spritevpg/spec.html",
  "type": "object",
  "required": [
    "format",
    "version",
    "entity",
    "art",
    "grid",
    "frames",
    "defaults",
    "ai",
    "provenance"
  ],
  "properties": {
    "format": {
      "const": "spritevpg"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "$schema": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": [
        "w",
        "h",
        "framesArea"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "pixelArt": {
          "type": "boolean",
          "default": true
        },
        "framesArea": {
          "type": "object",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "const": 0
            },
            "y": {
              "const": 0
            },
            "w": {
              "type": "integer",
              "minimum": 1
            },
            "h": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "character",
                "creature",
                "item",
                "prop",
                "building",
                "effect",
                "tile"
              ]
            },
            {
              "$ref": "#/$defs/custom"
            }
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "art": {
      "type": "object",
      "properties": {
        "view": {
          "enum": [
            "side",
            "front",
            "threeQuarter",
            "oblique",
            "topDown",
            "isometric"
          ]
        },
        "facing": {
          "$ref": "#/$defs/direction"
        },
        "light": {
          "type": "string"
        },
        "outline": {
          "type": "object",
          "properties": {
            "style": {
              "enum": [
                "dark",
                "colored",
                "none"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "shadow": {
          "enum": [
            "none",
            "baked",
            "separate"
          ]
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "color"
            ],
            "properties": {
              "color": {
                "$ref": "#/$defs/color"
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "view"
      ]
    },
    "grid": {
      "type": "object",
      "required": [
        "columns",
        "rows",
        "frameSize"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "frameSize": {
          "$ref": "#/$defs/size"
        },
        "margin": {
          "const": 0
        },
        "spacing": {
          "const": 0
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "i",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "i": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "w": {
            "type": "integer",
            "minimum": 1
          },
          "h": {
            "type": "integer",
            "minimum": 1
          },
          "pivot": {
            "$ref": "#/$defs/point"
          },
          "boxes": {
            "$ref": "#/$defs/boxes"
          },
          "points": {
            "$ref": "#/$defs/points"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "pivot": {
          "$ref": "#/$defs/point"
        },
        "boxes": {
          "$ref": "#/$defs/boxes"
        },
        "points": {
          "$ref": "#/$defs/points"
        }
      },
      "required": [
        "pivot"
      ]
    },
    "directions": {
      "type": "object",
      "properties": {
        "set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/direction"
          }
        },
        "mirror": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "from"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/direction"
              },
              "flip": {
                "enum": [
                  "x",
                  "y"
                ]
              }
            }
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "frames"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "direction": {
            "$ref": "#/$defs/direction"
          },
          "loop": {
            "enum": [
              "loop",
              "once",
              "pingpong",
              "hold"
            ],
            "default": "loop"
          },
          "next": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "frame",
                "ms"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "offset": {
                  "type": "object",
                  "properties": {
                    "dx": {
                      "type": "integer"
                    },
                    "dy": {
                      "type": "integer"
                    }
                  }
                },
                "pivot": {
                  "$ref": "#/$defs/point"
                },
                "boxes": {
                  "$ref": "#/$defs/boxes"
                },
                "points": {
                  "$ref": "#/$defs/points"
                }
              }
            }
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "animation": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        },
        "oneOf": [
          {
            "required": [
              "frame"
            ]
          },
          {
            "required": [
              "animation"
            ]
          }
        ]
      }
    },
    "world": {
      "type": "object",
      "properties": {
        "pixelsPerUnit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "footprint": {
          "type": "object",
          "required": [
            "tileSize",
            "w",
            "h"
          ],
          "properties": {
            "tileSize": {
              "type": "integer",
              "minimum": 1
            },
            "w": {
              "type": "integer",
              "minimum": 1
            },
            "h": {
              "type": "integer",
              "minimum": 1
            },
            "origin": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "sortY": {
          "type": "integer"
        },
        "shadow": {
          "type": "object",
          "properties": {
            "frame": {
              "type": "integer"
            },
            "offset": {
              "type": "object"
            }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "proportions": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "type": "object",
          "properties": {
            "frame": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "howTo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generator": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        },
        "created": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "custom": {
      "type": "string",
      "pattern": "^custom:[a-z0-9_\\-]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "size": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "boxes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rect"
      }
    },
    "points": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/point"
      }
    },
    "direction": {
      "enum": [
        "down",
        "up",
        "left",
        "right",
        "down-left",
        "down-right",
        "up-left",
        "up-right"
      ]
    }
  }
}