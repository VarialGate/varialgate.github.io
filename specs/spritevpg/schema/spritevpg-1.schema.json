{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varialgate.github.io/specs/spritevpg/schema/spritevpg-1.schema.json",
  "title": "SpriteVPG 1 · ficha de un sprite pattern",
  "description": "Lo que dice un sprite pattern SpriteVPG: nombre, tamaño de frame, rejilla y una fila por animación. Especificación: https://varialgate.github.io/specs/spritevpg/spec.html",
  "type": "object",
  "required": [
    "format",
    "version",
    "name",
    "frame",
    "grid",
    "rows"
  ],
  "properties": {
    "format": {
      "const": "spritevpg"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "frames"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$"
          },
          "frames": {
            "type": "integer",
            "minimum": 1,
            "description": "Celdas con dibujo de la fila, desde la izquierda"
          },
          "ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Duración de cada frame. Sin ms, la fila son imágenes sueltas"
          },
          "loop": {
            "enum": [
              "loop",
              "once"
            ]
          }
        },
        "dependentRequired": {
          "ms": [
            "loop"
          ]
        }
      }
    }
  }
}